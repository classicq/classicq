#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_UBO
{
    float cltime;
    packed_float3 pad;
};

struct main0_out
{
    float4 out_var_SV_Target [[color(0)]];
};

struct main0_in
{
    float4 in_var_TEXCOORD0 [[user(locn0)]];
    float2 in_var_TEXCOORD1 [[user(locn1)]];
};

fragment main0_out main0(main0_in in [[stage_in]], constant type_UBO& UBO [[buffer(0)]], texture2d<float> tex [[texture(0)]], sampler smp [[sampler(0)]])
{
    main0_out out = {};
    out.out_var_SV_Target = tex.sample(smp, float2(in.in_var_TEXCOORD1.x + (0.125 + (sin((in.in_var_TEXCOORD1.y + UBO.cltime) * 3.1415927410125732421875) * 0.125)), in.in_var_TEXCOORD1.y + (0.125 + (sin((in.in_var_TEXCOORD1.x + UBO.cltime) * 3.1415927410125732421875) * 0.125)))) * in.in_var_TEXCOORD0;
    return out;
}

