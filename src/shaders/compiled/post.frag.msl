#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_UBO
{
    float4 blend;
    float gamma;
    float contrast;
    float2 pad;
};

struct main0_out
{
    float4 out_var_SV_Target [[color(0)]];
};

struct main0_in
{
    float2 in_var_TEXCOORD0 [[user(locn0)]];
};

fragment main0_out main0(main0_in in [[stage_in]], constant type_UBO& UBO [[buffer(0)]], texture2d<float> scene [[texture(0)]], sampler smp [[sampler(0)]])
{
    main0_out out = {};
    out.out_var_SV_Target = float4(powr(precise::max(mix(scene.sample(smp, in.in_var_TEXCOORD0).xyz, UBO.blend.xyz, float3(UBO.blend.w)) * UBO.contrast, float3(0.0)), float3(UBO.gamma)), 1.0);
    return out;
}

