#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct main0_out
{
    float4 out_var_SV_Target [[color(0)]];
};

struct main0_in
{
    float2 in_var_TEXCOORD1 [[user(locn1)]];
    float2 in_var_TEXCOORD2 [[user(locn2)]];
};

fragment main0_out main0(main0_in in [[stage_in]], texture2d<float> solid_tex [[texture(0)]], texture2d<float> alpha_tex [[texture(1)]], sampler solid_smp [[sampler(0)]], sampler alpha_smp [[sampler(1)]])
{
    main0_out out = {};
    float4 _35 = alpha_tex.sample(alpha_smp, in.in_var_TEXCOORD2);
    out.out_var_SV_Target = float4(mix(solid_tex.sample(solid_smp, in.in_var_TEXCOORD1).xyz, _35.xyz, float3(_35.w)), 1.0);
    return out;
}

